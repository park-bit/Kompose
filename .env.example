# LLM (Required)
LLM_API_KEY=your_google_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash

# Database & Cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/travel_planner
REDIS_URL=redis://localhost:6379/0

# Amadeus Flights & Hotels (free test tier at developers.amadeus.com)
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here
AMADEUS_HOSTNAME=test

# Optional (has built-in fallbacks if omitted)
APIFY_API_TOKEN=
OPENWEATHER_API_KEY=
EXCHANGERATE_API_KEY=

# Debug
DEBUG=false
